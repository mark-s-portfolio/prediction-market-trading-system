# Public portfolio runtime. The standalone entrypoint is observe-only.

# Optional venue credentials. Never commit real values.
POLYMARKET_PRIVATE_KEY=
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=
POLYMARKET_FUNDER=
POLYMARKET_SIGNATURE_TYPE=2

# Optional notifications.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Public market-data endpoints / runtime settings.
PM_GAMMA_API_URL=https://gamma-api.polymarket.com
PM_CLOB_API_URL=https://clob.polymarket.com
PM_MARKET_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market
PM_CHAIN_ID=137
PM_CONNECT_TIMEOUT_SEC=3.0
PM_READ_TIMEOUT_SEC=5.0
PM_RETRY_ATTEMPTS=2
PM_RETRY_BACKOFF_SEC=0.25
PM_DISCOVERY_CACHE_SEC=60.0
PM_MARKETS=bitcoin,ethereum,solana,xrp

# Safe defaults. main.py refuses standalone live execution.
PM_PAPER_MODE=true
PM_LIVE_TRADING_ENABLED=false
PM_DETAILED_LOGS=false

TRADING_FALLBACK_LOG_PATH=trading-runtime.log
TRADING_LOG_QUEUE_MAX=10000
